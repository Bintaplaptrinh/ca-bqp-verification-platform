# Local development only. Replace all *_PASSWORD / secret values before any shared deployment.
APP_ENV=development
AUTH_DISABLED=false

# Deployment profile.
#   local  — one process: filesystem document storage, in-process task runner,
#            PostgreSQL the only service. `ops/local.py` writes this profile.
#   docker — MinIO object storage and a Celery worker against Redis, as compose.yaml runs.
RUNTIME_PROFILE=docker
STORAGE_BACKEND=auto
QUEUE_BACKEND=auto
STORAGE_ROOT=.local/documents

DATABASE_URL=postgresql+psycopg://cabqp:change_me@postgres:5432/cabqp
POSTGRES_DB=cabqp
POSTGRES_USER=cabqp
POSTGRES_PASSWORD=change_me

REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=cabqp
MINIO_SECRET_KEY=change_me_minio
MINIO_BUCKET=cabqp-documents
MINIO_SECURE=false

# Accounts live in this platform's own database. The seeder creates the single
# administrator (admin/admin) and the default tra cứu account (user/user);
# every other account is issued by the administrator in the product.
# Change both passwords before this instance is reachable by anyone else.
#   apps/backend/scripts/seed_accounts.py

# Outgoing mail — Gmail SMTP only. Issued and reset passwords are delivered
# through this account; there is no self-hosted SMTP host setting and no
# offline file transport any more. GMAIL_APP_PASSWORD is a Google *app
# password* (Account > Security > 2-Step Verification > App passwords), not the
# account's own password. Gmail rewrites a From it does not own, so the sender
# address is always GMAIL_USER and only the display name is configurable.
# Production refuses to start with either value missing.
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM_NAME=Hệ thống tra cứu CA/BQP

# One-time sign-in codes mailed to the account's own address. Every value here
# is a spam/abuse control, so raise them only deliberately:
#   OTP_TTL_SECONDS                how long one code is worth guessing
#   OTP_MAX_ATTEMPTS               wrong guesses before the code is burned
#   OTP_RESEND_COOLDOWN_SECONDS    one message per mailbox per window; Settings
#                                  refuses a value below OTP_TTL_SECONDS
#   OTP_MAX_PER_ACCOUNT_PER_HOUR   total mail one account can cause
#   OTP_MAX_PER_IP_PER_HOUR        total mail one address can cause, which is
#                                  what stops a sprayer walking a username list
# The feature switches itself off when GMAIL_USER/GMAIL_APP_PASSWORD are unset:
# a code that cannot be delivered is never issued.
OTP_LOGIN_ENABLED=true
OTP_TTL_SECONDS=60
OTP_CODE_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_ACCOUNT_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=20
OTP_RETENTION_HOURS=24

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true
# Per client address, per route shape.
RATE_LIMIT_PER_MINUTE=120
# Per client address across every route, so spraying many paths is not a way
# around the per-route budget.
RATE_LIMIT_IP_PER_MINUTE=600
# Rejected sign-in attempts per address per minute. Successful ones are free,
# so an operator working normally never reaches this.
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_FAIL_OPEN=true
# Addresses or CIDR ranges of the proxies in front of the API (WAF, load
# balancer, the web container). Only these peers may name the client through
# X-Forwarded-For; anyone else is rate-limited by the address they connect from.
# Leave empty when the API is reached directly, as it is in the local profile.
# Example behind a reverse proxy: TRUSTED_PROXY_IPS=10.20.0.5,172.16.0.0/12
TRUSTED_PROXY_IPS=
# Clickjacking / MIME-sniffing response headers. Production refuses to start
# with these off. The SPA carries its own copy in apps/web/nginx.conf.
SECURITY_HEADERS_ENABLED=true
FRAME_ANCESTORS='none'
# One live session per account: a second sign-in ends the first.
SINGLE_ACTIVE_SESSION=true
MAX_UPLOAD_MB=25

CLAMAV_HOST=clamav
CLAMAV_PORT=3310
ANTIMALWARE_ENABLED=true
# Set true in production; Settings refuses production startup otherwise.
ANTIMALWARE_REQUIRED=false
ANTIMALWARE_TIMEOUT_SECONDS=8

RESOLVER_FUZZY_THRESHOLD=91
RESOLVER_MARGIN_THRESHOLD=6
RESOLVER_CALIBRATED_ACCEPT_THRESHOLD=0.90
RESOLVER_SEMANTIC_THRESHOLD=0.82
RESOLVER_SEMANTIC_MARGIN_THRESHOLD=0.08
RESOLVER_ALLOW_SEMANTIC_AUTOACCEPT=false
RESOLVER_REQUIRE_CALIBRATION_FOR_FUZZY_AUTOACCEPT=true
RESOLVER_CALIBRATION_PATH=artifacts/resolver_calibration.json
EMBEDDING_ENABLED=true
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_LOCAL_FILES_ONLY=false

PARSER_VERSION=parser-2026.09-production.1
MODEL_VERSION=hybrid-rule-ner-2026.09-production.1
THRESHOLD_VERSION=threshold-calibrated-2026.09-v1
TAXONOMY_VERSION=taxonomy-2026.09

METRICS_ENABLED=true
SEED_ALLOW_PRODUCTION=false
# Registry CSV the seed job loads. Only rows with qa_status=APPROVED are seeded.
# Unset to fall back to the 43-unit baseline shipped inside the image.
REGISTRY_SEED_PATH=/app/registry/master_units_registry.csv

# Document quality gates
OCR_MIN_CONFIDENCE=0.70
OCR_DETECTOR=easyocr
OCR_RECOGNIZER=easyocr
OCR_FALLBACK_ENABLED=true
OCR_FALLBACK_DETECTOR=paddle
OCR_FALLBACK_RECOGNIZER=paddle
QUALITY_CONFIG_PATH=config/document_quality.yaml
HEADER_ALIAS_PATH=config/header_aliases.yaml
# How many people one spreadsheet import may create Cases for. A longer list is
# refused outright, with nothing queued, and the operator is told to split it.
BULK_MAX_ROWS=50
BULK_AUTO_MAP_THRESHOLD=0.90
BULK_OCR_TABLE_CONFIDENCE_MIN=0.80
BULK_HEADER_ALIAS_MIN=0.75
BULK_RECORD_NAME_VALUE_MIN=0.60
BULK_TABLE_LABEL_ANTISIGNAL_MAX=0.25
SCAN_TABLE_DETECTION_ENABLED=true
DOCUMENT_PARSE_MIN_CONFIDENCE=0.60
